# Google Cloud Console API Keys
# Enable: Maps JavaScript API, Places API, Geocoding API, and Google Civic Information API

# 1. Google Maps JavaScript API Key (Used for map rendering & minimal street style)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# 2. Google Civic Information API Key (Optional if same as Maps key)
# If left blank or unset, the app will automatically use VITE_GOOGLE_MAPS_API_KEY
VITE_GOOGLE_CIVIC_API_KEY=AIzaSyYourGoogleCivicApiKeyHere
