{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "louderthanwords",
	"account_id": "3b9f1c5cbf17023810d2362c4c6547c0",
	"workers_dev": true,
	"compatibility_date": "2026-09-14",
	"main": "./worker/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"html_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "civic_data",
			"database_id": "9729fa7a-1324-4f40-9f61-f719486fc5fd"
		}
	]
}