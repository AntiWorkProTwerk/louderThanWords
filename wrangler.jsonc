{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "louderthanwords",
  "account_id": "7a0041ac239768cfdb356ff743bd0bc9",
  "workers_dev": true,
  "compatibility_date": "2026-09-14",
  "main": "./worker/index.js",
  "routes": [
    {
      "pattern": "louderthanwords.fyi",
      "custom_domain": true
    }
  ],
  "assets": {
    "run_worker_first": true,
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none"
  }
}
