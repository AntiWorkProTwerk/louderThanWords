{
  "name": "louder-than-words",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:dukevibington": "npm run dev --workspace @louder-than-words/dukevibington",
    "build": "node scripts/build-all.mjs",
    "preview": "node scripts/preview.mjs",
    "sites:sync": "node scripts/sync-sites.mjs",
    "check": "npm run build",
    "deploy": "node scripts/deploy.mjs",
    "deploy:preview": "node scripts/deploy.mjs --preview",
    "d1:migrate": "wrangler d1 execute civic_data --remote --file=./servers/dukevibington/schema.sql --yes",
    "ingest": "node servers/dukevibington/ingest.mjs",
    "harvest": "node servers/dukevibington/batch_harvest.mjs",
    "r2:upload:co": "wrangler r2 object put civic-bundles/dukevibington/states/CO.json --file=./servers/dukevibington/bundles/states/CO.json --remote"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^6.0.3",
    "vite": "^7.1.5",
    "wrangler": "^4.35.0"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "ws": "^8.21.0",
    "@sveltejs/kit": { "cookie": "^0.7.2" }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/topojson-client": "^3.1.5",
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "topojson-client": "^3.1.0"
  }
}
